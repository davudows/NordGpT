[Unit]
Description=NordGpT Local AI Chat Interface
Documentation=https://github.com/davudows/NordGpT
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=nordgpt
Group=nordgpt
WorkingDirectory=/opt/nordgpt
ExecStart=/opt/nordgpt/.venv/bin/python -m uvicorn app:app \
    --host 0.0.0.0 \
    --port 7860 \
    --log-level warning \
    --no-access-log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nordgpt

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/nordgpt/data
ProtectHome=yes

[Install]
WantedBy=multi-user.target
